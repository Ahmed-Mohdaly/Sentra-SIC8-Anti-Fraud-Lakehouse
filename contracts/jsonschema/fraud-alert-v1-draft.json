{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Fraud alert grain: one row per event and rule hit",
  "type": "object",
  "properties": {
    "alert_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "related_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_id": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "alert_id",
    "event_id",
    "rule_id",
    "rule_version",
    "evidence",
    "detected_at"
  ]
}
