{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://sic8.local/schema/transaction-v1-draft.json",
  "title": "Canonical payment event; detector input only",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "POS",
        "ECOMMERCE",
        "ATM"
      ]
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "amount": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        {
          "type": "number"
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "status": {
      "enum": [
        "APPROVED",
        "DECLINED",
        "ERROR"
      ]
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "location_precision": {
      "enum": [
        "EXACT_SYNTHETIC",
        "APPROXIMATE_CENTROID",
        "UNKNOWN"
      ]
    },
    "terminal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "mcc": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "event_id",
    "transaction_id",
    "account_id",
    "card_id",
    "channel",
    "event_time",
    "amount",
    "currency",
    "status"
  ]
}
