# ==============================================================================
# SIC8 Project 01 — Real-Time Payment Ingestion & Anti-Fraud Lakehouse
# Consolidated Environment Template (Safe Placeholders Only — Never Commit Secrets)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Safety & Demo Guardrails (Offline Default)
# ------------------------------------------------------------------------------
SIC8_CLOUD_WRITES=false
SIC8_ALLOW_DEPLOY=false
SIC8_DEMO_DATA_ROOT=build/demo
SIC8_DEMO_SQLITE=build/demo/gold_fixture.sqlite
SIC8_API_DEMO_TOKEN=local-demo-token-xyz

# ------------------------------------------------------------------------------
# 2. R1 Synthetic Streaming Generator & API
# ------------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
GENERATOR_RATE=10.0
GENERATOR_BATCH_SIZE=50
SYNTH_NEW_USER_TRANSACTION_RATIO=0.10
AUTO_SEED=true
BASELINE_DATA_DIR=data
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. R1 Relational OLTP Database (PostgreSQL / Amazon RDS)
# ------------------------------------------------------------------------------
# Local Docker development:
LOCAL_POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgresql://sic8:postgrespassword@localhost:5432/synthetic_db
# Cloud RDS (Production):
# DATABASE_URL=postgresql://sic8_admin:<PASSWORD>@<RDS_ENDPOINT>:5432/synthetic_db?sslmode=require

# ------------------------------------------------------------------------------
# 4. R1 Streaming Event Backbone (Kafka / Amazon MSK)
# ------------------------------------------------------------------------------
SIC8_KAFKA_BOOTSTRAP=localhost:9092
SIC8_KAFKA_TOPIC=transactions
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_FRAUD_ALERTS=fraud_alerts
KAFKA_TOPIC_DLQ=transactions_dlq
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ------------------------------------------------------------------------------
# 5. R1 Real-Time Fraud ML & Feature Store (ElastiCache Redis / In-Memory Fallback)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false
SIC8_MODEL_PATH=models/v2/fraud_lgbm_model.joblib
SIC8_MODEL_METADATA=models/v2/model_metadata.json

# ------------------------------------------------------------------------------
# 6. R2 Databricks & Lakehouse Catalogs
# ------------------------------------------------------------------------------
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=sic8_lakehouse
# Databricks authentication credentials MUST remain in AWS Secrets Manager / Vault.
